# ---- Bland AI (the calling engine) -------------------------------------------
# Get a key at https://app.bland.ai  (Settings -> API Keys). Add call credits.
BLAND_API_KEY=

# Optional: a phone number to call FROM. Leave blank to use Bland's shared pool,
# or buy/verify a number in Bland and paste it here in E.164, e.g. +19195551234
FROM_NUMBER=

# Voice + limits
VOICE=june
MAX_DURATION_MIN=6

# Calling window (local time of the number's area code), weekdays only
CALL_WINDOW_START=9
CALL_WINDOW_END=17
SECONDS_BETWEEN_CALLS=8

# Recording + optional results webhook
RECORD=true
WEBHOOK_URL=

# ---- Deployment (see DEPLOY.md) ----------------------------------------------
# Set PUBLIC_BASE_URL to your deployed origin (no trailing slash) to switch the app
# from "poll until each call ends" to "Vapi POSTs the report to /api/webhook/vapi".
# Required on serverless (Vercel); optional but better anywhere else. Leave blank locally.
PUBLIC_BASE_URL=
WEBHOOK_SECRET=

# Serverless state. Without these, state is JSON files under data/ (fine locally,
# broken on Vercel). Upstash Redis -> Database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Engine switch -----------------------------------------------------------
# "bland" (default runner: caller.campaign) or "eleven" (caller.eleven)
ENGINE=bland

# ---- ElevenLabs Conversational AI (if ENGINE=eleven) — see AGENT_SETUP.md -----
ELEVENLABS_API_KEY=
ELEVEN_AGENT_ID=
ELEVEN_AGENT_PHONE_NUMBER_ID=
ELEVEN_TRANSPORT=twilio

# ---- Vapi (if using caller/vapi.py — the free-credits path, see CREDITS.md) ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE=Paige
